rules_version = '2';
// Todo cerrado salvo lo que se abre explícitamente abajo.
service cloud.firestore {
  match /databases/{database}/documents {

    // Equipo de Atlas: un documento por persona autorizada (id = uid de Auth).
    // Solo se administra desde la consola o con credenciales de Google Cloud.
    function esEquipo() {
      return request.auth != null
        && exists(/databases/$(database)/documents/equipo/$(request.auth.uid));
    }

    match /equipo/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Inspecciones: las lee y escribe solo el equipo. No se borran desde la
    // app (se marcan con borrada = true) y quien escribe queda registrado.
    match /inspecciones/{id} {
      allow read: if esEquipo();
      allow create, update: if esEquipo()
        && request.resource.data.editadoPor == request.auth.uid
        && request.resource.data.actualizado is timestamp;
      allow delete: if false;
    }

    // Marketplace de atlasmotors.cl: autos en venta. Cualquiera los lee (la web
    // los muestra sin login); solo el equipo los publica, edita o quita.
    // No llevan patente ni datos del dueño.
    match /publicaciones/{id} {
      allow read: if true;
      allow delete: if esEquipo();
      allow create, update: if esEquipo() && publicacionValida(request.resource.data, id);
    }

    // Lo que se publica se muestra en atlasmotors.cl: solo campos conocidos,
    // con su tipo y largo, y archivos alojados en nuestro Storage.
    function publicacionValida(d, id) {
      let storage = '^https://firebasestorage[.]googleapis[.]com/v0/b/atlas-motors-cl-fotos/o/publicaciones%2F.*';
      return d.keys().hasOnly(['id', 'folio', 'marca', 'modelo', 'anio', 'km', 'precio', 'comuna', 'combustible',
            'transmision', 'descripcion', 'comentario', 'puntaje', 'recomendacion', 'nivel', 'conteo', 'etapas',
            'hallazgos', 'fotos', 'videos', 'ficha', 'fechaInspeccion', 'publicado', 'actualizado'])
        && d.id == id
        && d.marca is string && d.marca.size() <= 60
        && d.modelo is string && d.modelo.size() <= 80
        && (d.anio is int || (d.anio is string && d.anio.size() <= 4))
        && (d.km == null || (d.km is int && d.km >= 0))
        && (d.precio == null || (d.precio is int && d.precio > 0))
        && (d.puntaje == null || (d.puntaje is int && d.puntaje >= 0 && d.puntaje <= 100))
        && (d.nivel == null || (d.nivel is int && d.nivel >= 0 && d.nivel <= 2))
        && d.comuna is string && d.comuna.size() <= 60
        && d.descripcion is string && d.descripcion.size() <= 3000
        && d.comentario is string && d.comentario.size() <= 3000
        && d.fotos is list && d.fotos.size() <= 40
        && (!('videos' in d) || (d.videos is list && d.videos.size() <= 4))
        && d.hallazgos is list && d.hallazgos.size() <= 100
        && d.etapas is list && d.etapas.size() <= 20
        && d.ficha is string && d.ficha.matches(storage);
    }

    // Estadísticas anónimas de atlasmotors.cl: un documento por día (AAAA-MM-DD)
    // con contadores. Cada escritura de la web declara en `_k` qué contadores
    // suma (1 a 4) y solo puede subir cada uno en 1: no puede leer, borrar ni
    // poner otros valores. Lee solo el equipo.
    match /estadisticas/{dia} {
      allow read: if esEquipo();
      allow create: if diaValido(dia) && sumaDeAUno(request.resource.data.keys(), {});
      allow update: if diaValido(dia) && sumaDeAUno(request.resource.data.diff(resource.data).affectedKeys(), resource.data);
      allow delete: if false;
    }

    function diaValido(dia) {
      return dia.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$');
    }

    function subeUno(k, antes) {
      return k is string && k.matches('^[a-z0-9_]{1,60}$')
        && request.resource.data[k] is int
        && request.resource.data[k] == antes.get(k, 0) + 1;
    }

    function sumaDeAUno(cambiadas, antes) {
      let ks = request.resource.data._k;
      return ks is list && ks.size() >= 1 && ks.size() <= 4 && request.resource.data.size() <= 1500
        && cambiadas.hasOnly(ks.concat(['_k']))
        && subeUno(ks[0], antes)
        && (ks.size() < 2 || subeUno(ks[1], antes))
        && (ks.size() < 3 || subeUno(ks[2], antes))
        && (ks.size() < 4 || subeUno(ks[3], antes));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
